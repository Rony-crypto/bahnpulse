# Copy this file to .env and fill in your values. Never commit .env.

# DB API Marketplace (https://developers.deutschebahn.com/db-api-marketplace)
DB_CLIENT_ID='your_db_client_id'
DB_API_KEY='your_db_api_key'

# Ask AI chat: providers are tried in this order; only those with a key are used.
# Groq (free, console.groq.com) is the main one; Mistral (free $10 credit a month,
# console.mistral.ai) is optional; Gemini/Gemma use the Google key as last resorts.
LLM_PROVIDERS=groq,mistral,gemini,gemma
MISTRAL_API_KEY='your_mistral_api_key'
GROQ_API_KEY='your_groq_api_key'
#GEMINI_API_KEY='your_gemini_api_key'
# Optional model overrides (defaults: mistral-medium-latest, openai/gpt-oss-120b,
# gemini-3.5-flash, gemma-4-31b-it; Gemini and Gemma share GEMINI_API_KEY)
#MISTRAL_MODEL=
#GROQ_MODEL=
# Further Groq models tried when the first one's daily allowance is used up
#GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
#GEMINI_MODEL=
#GEMMA_MODEL=

# Hugging Face token with write access: only for the live hub collector (collect_hubs), which
# uploads raw snapshots to a private dataset. Not needed for the monthly pipeline or the app.
HF_TOKEN='your_hf_token'
