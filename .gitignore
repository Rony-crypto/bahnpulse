# Secrets
.env

# Data (never commit raw data; it is downloaded or collected). The small published
# aggregate marts are committed so the public Streamlit app can read them (FR-11).
data/*
!data/published/
*.duckdb
*.duckdb.wal

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# OS / editor
.DS_Store
.vscode/
.idea/

# dbt per-machine user id
dbt/.user.yml
